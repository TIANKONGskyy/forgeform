{
  "backend": {
    "mode": "auto",
    "_doc": "auto=启动时探测这台机器有什么（Ollama / ComfyUI / llama.cpp / vLLM / LM Studio / 本地 diffusers / hy3dgen），按阶段自动路由；comfyui=只走 ComfyUI（默认，行为不变）；direct=只走直连。见 docs/BACKENDS.md"
  },
  "agent": {
    "enabled": true,
    "provider": "strata",
    "tuned_url": "http://127.0.0.1:8082",
    "prompt_style": "compact",
    "strata_url": "http://127.0.0.1:8091/v1",
    "strata_model": "qwen3.8-flash-next-iq3_s",
    "_doc": "provider: strata=本地 OpenAI 兼容推理服务(agent.strata_url)；ollama=Ollama；off=纯规则模式不调 LLM"
  },
  "app": {
    "name": "铸想 ForgeForm",
    "host": "127.0.0.1",
    "port": 7860,
    "share": false
  },
  "paths": {
    "comfyui": "${COMFYUI_DIR}",
    "models": "${COMFYUI_DIR}/models",
    "output": "./outputs",
    "temp": "./temp",
    "meshy_api": "./meshy_api"
  },
  "comfyui_ports": {
    "image": 8188,
    "media": 8188
  },
  "models": {
    "llm": {
      "default_model": "qwen3.8:latest",
      "think": "low",
      "fallback_model": "gpt-oss:20b",
      "temperature": 0.7,
      "default_num_predict": 1200,
      "models": {
        "gpt-oss:20b": {
          "think": "low",
          "num_predict": 2600,
          "num_ctx": 8192
        },
        "qwen3.8:latest": {
          "think": false,
          "num_predict": 1800,
          "temperature": 0.2,
          "num_ctx": 8192
        }
      },
      "_think": "low",
      "_think_note": "默认推理档位。实测 gpt-oss-20b 在 low/medium/high 的判断命中都是 5/5；high/medium 会把预算烧在思考上导致首轮正文为空，故默认 low"
    },
    "image": {
      "flux": {
        "name": "FLUX.1-dev FP8",
        "checkpoint": "flux1-dev-fp8.safetensors",
        "vae": "ae.safetensors",
        "clip_l": "clip_l.safetensors",
        "clip_t5": "t5xxl_fp8_e4m3fn.safetensors",
        "fallback": null,
        "steps": 28,
        "cfg": 1.0,
        "teacache": false,
        "teacache_thresh": 0.3,
        "teacache_type": "flux",
        "resolution": [
          1024,
          1024
        ],
        "guidance": 3.5,
        "fbcache": false,
        "fbcache_thresh": 0.12,
        "hyper_lora": "",
        "sampler": "euler",
        "scheduler": "simple"
      },
      "flux_klein": {
        "name": "FLUX.2 Klein 9B Q5",
        "checkpoint": "flux-2-klein-9b-Q5_K_M.gguf",
        "vae": "flux2-vae.safetensors",
        "clip_l": "flux2-klein-9b-encoder-q8_0.gguf",
        "lora": "flux2klein_3dprint.safetensors",
        "steps": 8,
        "cfg": 1.0,
        "resolution": [
          1024,
          1024
        ]
      },
      "flux2_dev": {
        "name": "FLUX.2 Dev 32B Q4",
        "checkpoint": "flux2-dev-q4_k_m.gguf",
        "vae": "flux2-vae.safetensors",
        "clip_l": "Mistral-Small-3.2-24B-Instruct-2506-Q4_K_M.gguf",
        "steps": 8,
        "cfg": 1.0,
        "resolution": [
          1024,
          1024
        ]
      },
      "z_image": {
        "name": "Z-Image Turbo 6B",
        "checkpoint": "z_image_turbo-Q8_0.gguf",
        "vae": "zimage_ae.safetensors",
        "clip_l": "Qwen3-4B-UD-Q5_K_XL.gguf",
        "steps": 8,
        "cfg": 1.0,
        "aura_shift": 3,
        "resolution": [
          1024,
          1024
        ]
      },
      "qwen21_ref": {
        "name": "Qwen-Image-2.1 参考图（本地 int8，照图生成指定角色）",
        "checkpoint": "qwen_image_2.1_int8_convrot.safetensors",
        "clip_l": "qwen3vl_8b_int8_convrot.safetensors",
        "vae": "qwen_image_2.1_vae_bf16.safetensors",
        "clip_type": "qwen_image",
        "steps": 20,
        "cfg": 4.0,
        "sampler": "euler",
        "scheduler": "simple"
      }
    },
    "video": {
      "h3": {
        "name": "MiniMax H3 (Image-to-Video)",
        "model": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
        "clip": "qwen3vl_32b_h3_ultra_uncensored_heretic_int8_convrot.safetensors",
        "clip_type": "minimax",
        "video_vae": "minimax_h3_video_vae_fp16.safetensors",
        "audio_vae": "minimax_h3_audio_vae_fp32.safetensors",
        "turbo_lora": "minimax_h3_turbo_4step_pruned_comfyui.safetensors",
        "turbo_lora_strength": 1.0,
        "turbo_enabled": true,
        "turbo_steps": 6,
        "fallback": null,
        "steps": 6,
        "cfg": 1.0,
        "duration": 5,
        "fps": 24,
        "resolution": [
          1344,
          768
        ]
      }
    },
    "3d": {
      "triposplat": {
        "name": "TripoSplat",
        "backend": "native_comfyui",
        "model": "triposplat_fp16.safetensors",
        "vae_decoder": "triposplat_vae_decoder_fp16.safetensors",
        "vae_encoder": "flux2-vae.safetensors",
        "clip_vision": "dino_v3_vit_h.safetensors"
      },
      "hunyuan21": {
        "name": "Hunyuan3D 2.1 最强质量",
        "backend": "hy21",
        "steps": 30,
        "guidance_scale": 7.5,
        "octree_resolution": 512,
        "note": "2.1 质量天花板（7GB 权重，单图 ShapeGen，约3分钟/个）"
      },
      "multiview": {
        "name": "Hunyuan3D V2 多视图",
        "backend": "multiview",
        "steps": 20,
        "guidance_scale": 5.0,
        "octree_resolution": 384,
        "note": "多视图重建（Zero123Plus 6视图 → ShapeGen MV），空间关系准确",
        "generation_mode": "Hunyuan3D-2mv-Fast"
      },
      "hunyuan3d": {
        "name": "Hunyuan3D v2.1",
        "backend": "comfy3d_pipeline",
        "steps": 20,
        "guidance_scale": 5.0,
        "octree_resolution": 384,
        "note": "V2 Fast (20步+FlashVDM)",
        "generation_mode": "Hunyuan3D-2-Fast"
      }
    }
  },
  "meshy": {
    "api_url": "http://localhost:3000/api/v1",
    "image_to_3d_endpoint": "/image-to-3d/generate",
    "text_to_3d_endpoint": "/text-to-3d/generate",
    "timeout": 600,
    "poll_interval": 10,
    "max_retries": 3
  },
  "stl_export": {
    "decimate_ratio": 0.5,
    "target_faces": 50000,
    "smooth_iterations": 2,
    "output_scale": "mm"
  },
  "stages": {
    "image": {
      "default_model": "qwen21_ref",
      "preview_candidates": 1,
      "default_negative": "low quality, blurry, distorted, deformed, ugly, bad anatomy, watermark, text, logo, rough, coarse, low detail, pixelated, grainy, oversimplified, low poly, plastic, unfinished, painted pattern, flat decal, flat texture, 2d pattern, fake texture",
      "fallback_chain": [
        "flux"
      ]
    },
    "video": {
      "default_model": "h3"
    },
    "3d": {
      "default_model": "hunyuan21",
      "fallback_chain": [
        "multiview"
      ]
    }
  },
  "comfyui_idle": {
    "free_after_minutes": 10
  },
  "generation": {
    "default_image_model": "qwen21_ref",
    "default_video_model": "h3",
    "default_3d_model": "hunyuan21",
    "default_batch_size": 4,
    "max_batch_size": 4
  },
  "autopilot": {
    "enabled": true,
    "delay_sec": 5,
    "model": "hunyuan21",
    "note": "图片就绪后 N 秒内用户没提修改需求 → 自动进入建模。默认 hunyuan21 + 快速档（octree 256=官方蓝图值，实测 160s）；手动点「生成建模」仍是标准档（512，细节多但可能十几分钟）。实测对比：multiview 反而更糊（仰躺+四肢成块）故不用；任何用户介入都会取消。",
    "quality": "快速"
  }
}