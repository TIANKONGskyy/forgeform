# 运行产物（都会在首次启动时自动重建）
outputs/
logs/
temp/
tmp/
projects/
models/
meshy_api/
parts_cad/out/

# 本地配置：含本机路径、端口、模型文件名。示例见 config.example.json
config.json
config.*.json
!config.example.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

