# 运行产物（都会在首次启动时自动重建）
outputs/
logs/
temp/
tmp/
projects/
models/
meshy_api/
parts_cad/out/

# LoRA 微调线的本地环境（数据 / 权重 / venv，几十 GB）。开源版不含，见 README
finetune/
training-data/

# 本地配置：含本机路径、端口、模型文件名。示例见 config.example.json
config.json
config.*.json
!config.example.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 模型权重与大文件（绝不入库）
*.safetensors
*.gguf
*.ckpt
*.pt
*.pth
*.onnx
*.bin
*.glb
*.gltf
*.obj
*.fbx
*.stl
*.3mf
*.step
*.stp
*.mp4
*.webm
*.mov
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.wav
*.mp3
*.zip
*.7z

# 例外：文档里用的示意图
!docs/assets/*.jpg
!docs/assets/*.png
!docs/assets/*.gif
# 宣传素材在 promo/ 子目录下，`*.png` 不跨目录，得单独放行
!docs/assets/promo/*.png
!docs/assets/promo/*.gif
!docs/assets/promo/*.mp4
# 例外：作品展示页的预览图（源图 image.png 不入库，只入库压缩后的 jpg）
!docs/showcase/*/*.jpg
# 2026-11-13：四件作品的 STL / GLB 也放行（约 33 MB）。
# 开源包只有源码太"空"——别人下下来除了代码什么都看不到。
# 这些是真实产物，能直接拖进切片器验证"这个项目真的出过东西"。
!docs/showcase/*/*.stl
!docs/showcase/*/*.glb
# 但 _bench* 是测试产物，不要
docs/showcase/_bench*/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 本地草稿与日志
.tmp_mm/
*.log
!docs/*.log

# 本地预览服务的 pid
.server.pid

# bench_direct.py 的产物
direct-bench/
docs/showcase/_bench/
config.json.bak
